l id="c72" value="Banco/Cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="1284" width="220" height="24" as="geometry"/></mxCell><mxCell id="c73" value="salao_id derivado do JWT; chave cache salao_id:mes (Implementado)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="1284" width="220" height="24" as="geometry"/></mxCell><mxCell id="c74" value="Testes de isolamento automatizados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="1284" width="200" height="24" as="geometry"/></mxCell><mxCell id="c75" value="Alteracao financeira indevida" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1308" width="110" height="24" as="geometry"/></mxCell><mxCell id="c76" value="Dominio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="1308" width="220" height="24" as="geometry"/></mxCell><mxCell id="c77" value="Transacoes + mes fechado + rollback (Implementado)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="1308" width="220" height="24" as="geometry"/></mxCell><mxCell id="c78" value="Auditoria, idempotency keys" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="1308" width="200" height="24" as="geometry"/></mxCell><mxCell id="c79" value="Exposicao de segredo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1332" width="110" height="24" as="geometry"/></mxCell><mxCell id="c80" value="DevOps" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="1332" width="220" height="24" as="geometry"/></mxCell><mxCell id="c81" value="Variaveis de ambiente; .env fora do git (Implementado)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="1332" width="220" height="24" as="geometry"/></mxCell><mxCell id="c82" value="Secret scanning, rotacao" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="1332" width="200" height="24" as="geometry"/></mxCell><mxCell id="c83" value="Perda de dados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1356" width="110" height="24" as="geometry"/></mxCell><mxCell id="c84" value="Banco" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="1356" width="220" height="24" as="geometry"/></mxCell><mxCell id="c85" value="Backup (Nao confirmado)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="1356" width="220" height="24" as="geometry"/></mxCell><mxCell id="c86" value="Backup + teste periodico de restauracao" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="1356" width="200" height="24" as="geometry"/></mxCell><mxCell id="c87" value="Falha operacional" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="110" height="24" as="geometry"/></mxCell><mxCell id="c88" value="Producao" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="1380" width="220" height="24" as="geometry"/></mxCell><mxCell id="c89" value="Sentry (Implementado)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="1380" width="220" height="24" as="geometry"/></mxCell><mxCell id="c90" value="Monitoramento, alertas, runbooks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="1380" width="200" height="24" as="geometry"/></mxCell><mxCell id="c91" value="Cache cruzado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1404" width="110" height="24" as="geometry"/></mxCell><mxCell id="c92" value="Cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="1404" width="220" height="24" as="geometry"/></mxCell><mxCell id="c93" value="Chave por tenant (Implementado)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="1404" width="220" height="24" as="geometry"/></mxCell><mxCell id="c94" value="Testes de isolamento do cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="1404" width="200" height="24" as="geometry"/></mxCell><mxCell id="c95" value="Mass assignment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1428" width="110" height="24" as="geometry"/></mxCell><mxCell id="c96" value="API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="1428" width="220" height="24" as="geometry"/></mxCell><mxCell id="c97" value="Sanitizacao de chaves crud.controller (Parcial - sem allowlist explicita)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="1428" width="220" height="24" as="geometry"/></mxCell><mxCell id="c98" value="Allowlist explicita de campos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="1428" width="200" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="02 - Autenticacao e autorizacao" id="p2"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c99" value="Fluxo completo de autenticacao e autorizacao (auth.controller.js, middleware/auth.js, apenasVendedor.js, App.jsx, api.js)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1A1A2E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1150" height="30" as="geometry"/></mxCell><mxCell id="c100" value="1. Usuario acessa tela de login (src/pages/Login.jsx)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="230" height="40" as="geometry"/></mxCell><mxCell id="c101" value="2. Frontend coleta email/username + senha" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="230" height="40" as="geometry"/></mxCell><mxCell id="c102" value="3. POST /auth/login (rota publica, sem auth)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="230" height="40" as="geometry"/></mxCell><mxCell id="c103" value="4. Pipeline app.js: headers -&gt; CORS -&gt; express.json -&gt; limiter 1000/15min -&gt; login limiter 100/15min" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="230" height="70" as="geometry"/></mxCell><mxCell id="c104" value="5. Lockout in-memory: loginAttempts Map - 5 falhas -&gt; 429 por 15min (isLockedOut/registerFailedAttempt/clearAttempts)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="230" height="70" as="geometry"/></mxCell><mxCell id="c105" value="6. Busca usuario: email -&gt; usuarios_auth WHERE email=? · username -&gt; perfis_acesso WHERE username=? -&gt; usuarios_auth" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="230" height="60" as="geometry"/></mxCell><mxCell id="c106" value="7. bcrypt.compare(senha, user.senha_hash) - bcrypt 10 rounds" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="230" height="50" as="geometry"/></mxCell><mxCell id="c107" value="8. Identifica: auth_user_id, salao_id (perfis_acesso), cargo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="230" height="40" as="geometry"/></mxCell><mxCell id="c108" value="9. jwt.sign({ auth_user_id, salao_id, cargo }, JWT_SECRET, { expiresIn: 24h })" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="230" height="50" as="geometry"/></mxCell><mxCell id="c109" value="10. Resposta: { token, cargo, salao_id, email, user_id }" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="230" height="40" as="geometry"/></mxCell><mxCell id="c110" value="11. Sessao no localStorage: authToken, userEmail, userRole, salaoId, userId" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="230" height="50" as="geometry"/></mxCell><mxCell id="c111" value="12. App.jsx roteia por cargo: VENDEDOR -&gt; VendedorApp · senao -&gt; Sidebar" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="230" height="50" as="geometry"/></mxCell><mxCell id="c112" value="13. Requisicoes protegidas: Authorization: Bearer JWT (api.js fetchWithAuth)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="230" height="50" as="geometry"/></mxCell><mxCell id="c113" value="14. middleware/auth.js: jwt.verify(token, JWT_SECRET) -&gt; req.user · falha -&gt; 401 Invalid token" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="310" y="70" width="250" height="60" as="geometry"/></mxCell><mxCell id="c114" value="15. req.user = { auth_user_id, salao_id, cargo } - salao_id vem SEMPRE do token, nunca do body" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="250" height="60" as="geometry"/></mxCell><mxCell id="c115" value="16. apenasVendedor.js: cargo !== VENDEDOR -&gt; 403 requires VENDEDOR" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="310" y="230" width="250" height="50" as="geometry"/></mxCell><mxCell id="c116" value="17. Dupla checagem no controller: listarSaloes/listarLoginsGerados revalidam VENDEDOR · atualizarSalao: salao_id === id || VENDEDOR" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="310" y="300" width="250" height="70" as="geometry"/></mxCell><mxCell id="c117" value="18. Service executa regra de negocio (financialEngine, fechamentoGuard)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="310" y="390" width="250" height="50" as="geometry"/></mxCell><mxCell id="c118" value="19. Query parametrizada: WHERE salao_id = ? (derivado do JWT)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="310" y="460" width="250" height="50" as="geometry"/></mxCell><mxCell id="c119" value="20. Resposta ao frontend · 401 -&gt; api.js limpa storage e window.location.replace(chr(47))" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="310" y="530" width="250" height="50" as="geometry"/></mxCell><mxCell id="c120" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c100" target="c101"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c121" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c101" target="c102"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c122" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c102" target="c103"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c123" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c103" target="c104"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c124" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c104" target="c105"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c125" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c105" target="c106"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c126" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c106" target="c107"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c127" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c107" target="c108"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c128" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c108" target="c109"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c129" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c109" target="c110"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c130" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c110" target="c111"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c131" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c111" target="c112"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c132" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c112" target="c113"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c133" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c113" target="c114"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c134" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c114" target="c115"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c135" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c115" target="c116"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c136" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c116" target="c117"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c137" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c117" target="c118"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c138" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c118" target="c119"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c139" value="Matriz de erros e bloqueios (status reais)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="310" y="620" width="250" height="20" as="geometry"/></mxCell><mxCell id="c140" value="Situacao" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontSize=10;fontStyle=1;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="310" y="645" width="120" height="20" as="geometry"/></mxCell><mxCell id="c141" value="Resposta do codigo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontSize=10;fontStyle=1;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="430" y="645" width="130" height="20" as="geometry"/></mxCell><mxCell id="c142" value="Token ausente" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="665" width="120" height="20" as="geometry"/></mxCell><mxCell id="c143" value="401 Token not provided" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="665" width="130" height="20" as="geometry"/></mxCell><mxCell id="c144" value="Token invalido/expirado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="685" width="120" height="20" as="geometry"/></mxCell><mxCell id="c145" value="401 Invalid token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="685" width="130" height="20" as="geometry"/></mxCell><mxCell id="c146" value="Cargo sem permissao" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="705" width="120" height="20" as="geometry"/></mxCell><mxCell id="c147" value="403 requires VENDEDOR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="705" width="130" height="20" as="geometry"/></mxCell><mxCell id="c148" value="Acesso a outro salao" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="725" width="120" height="20" as="geometry"/></mxCell><mxCell id="c149" value="403 Acesso negado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="725" width="130" height="20" as="geometry"/></mxCell><mxCell id="c150" value="Excesso de requisicoes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="745" width="120" height="20" as="geometry"/></mxCell><mxCell id="c151" value="429 (limiter) / 429 (lockout)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="745" width="130" height="20" as="geometry"/></mxCell><mxCell id="c152" value="Erro interno" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="765" width="120" height="20" as="geometry"/></mxCell><mxCell id="c153" value="500 Internal server error" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="765" width="130" height="20" as="geometry"/></mxCell><mxCell id="c154" value="Token expirado (frontend)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="785" width="120" height="20" as="geometry"/></mxCell><mxCell id="c155" value="limpa storage -&gt; login" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="785" width="130" height="20" as="geometry"/></mxCell><mxCell id="c156" value="Matriz de autorizacao por cargo" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="560" height="20" as="geometry"/></mxCell><mxCell id="c157" value="Cargo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontSize=10;fontStyle=1;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="600" y="95" width="80" height="120" as="geometry"/></mxCell><mxCell id="c158" value="Permissoes confirmadas no codigo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontSize=10;fontStyle=1;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="680" y="95" width="240" height="120" as="geometry"/></mxCell><mxCell id="c159" value="Restricoes / bloqueios confirmados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontSize=10;fontStyle=1;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="920" y="95" width="240" height="120" as="geometry"/></mxCell><mxCell id="c160" value="VENDEDOR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="215" width="80" height="120" as="geometry"/></mxCell><mxCell id="c161" value="GET /salao, POST /salao/criar-proprietaria, DELETE /salao/:salao_id (21 deletes) - todos apenasVendedor · /admin/*: listarAdmins, logins-gerados, criar-admin, remover-admin · listarSaloes WHERE vendedor_id = auth_user_id AND deletado_em IS NULL · logins_gerados com senha_temporaria" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="215" width="240" height="120" as="geometry"/></mxCell><mxCell id="c162" value="Fora do escopo: so saloes com vendedor_id = JWT · apenasVendedor.js em /admin/* e POST/DELETE /salao/* · dupla checagem no controller (listarSaloes, listarLoginsGerados) · nao usar frontend para contornar permissoes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="215" width="240" height="120" as="geometry"/></mxCell><mxCell id="c163" value="PROPRIETARIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="335" width="80" height="120" as="geometry"/></mxCell><mxCell id="c164" value="Acesso ao proprio salao_id: /agenda, /dashboard, /precificacao, /homecar, /paralelos, /clientes, /configuracoes (App.jsx) · verifyDashboardPassword e rotas /cadastros /atendimentos /fechamento /relatorios com WHERE salao_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="335" width="240" height="120" as="geometry"/></mxCell><mxCell id="c165" value="Somente o proprio salao_id em todas as queries · atualizarSalao exige salao_id === id · PIN do dashboard validado so no backend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="335" width="240" height="120" as="geometry"/></mxCell><mxCell id="c166" value="FUNCIONARIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="455" width="80" height="120" as="geometry"/></mxCell><mxCell id="c167" value="/agenda, /clientes (Sidebar roles + App.jsx Navigate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="455" width="240" height="120" as="geometry"/></mxCell><mxCell id="c168" value="/dashboard, /precificacao, /homecar, /paralelos, /configuracoes -&gt; Navigate to /agenda · backend nao bloqueia rotas por cargo FUNCIONARIO - aplica apenas escopo de tenant (risco anotado)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="455" width="240" height="120" as="geometry"/></mxCell><mxCell id="c169" value="Protecao de frontend melhora a experiencia, mas a decisao final deve ocorrer no backend (middleware + controller + query). Frontend apenas oculta telas - rotas /atendimentos /fechamento /cadastros /relatorios nao restringem FUNCIONARIO no backend, apenas o escopo de tenant." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="600" y="620" width="560" height="50" as="geometry"/></mxCell><mxCell id="c170" value="Observacoes de seguranca da sessao: · JWT em localStorage - exposto a XSS (Recomendado: cookies HttpOnly/Secure/SameSite) · Sem revogacao de sessao nem invalidacao pos-troca de senha (Recomendado - Nao confirmado) · Mensagens de login genericas Invalid credentials (mitiga enumeracao - Parcial) · Senha de proprietaria gerada no frontend com Math.random (risco - aba 03) · Falhas de login: apenas console.error - sem log estruturado nem alerta (Recomendado)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="600" y="680" width="560" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="03 - Frontend" id="p3"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c171" value="Arquitetura do frontend - src/ (Vite + React, deploy Vercel)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1A1A2E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1150" height="30" as="geometry"/></mxCell><mxCell id="c172" value="Boot e ciclo de vida" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="280" height="20" as="geometry"/></mxCell><mxCell id="c173" value="main.jsx - ponto de boot · CURRENT_APP_VERSION = v8.1.2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="280" height="40" as="geometry"/></mxCell><mxCell id="c174" value="Compara app_version no localStorage · se mudou: localStorage.clear() + sessionStorage.clear() + grava nova versao (cache-busting)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="280" height="70" as="geometry"/></mxCell><mxCell id="c175" value="ErrorBoundary envolvendo toda a arvore React" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="280" height="40" as="geometry"/></mxCell><mxCell id="c176" value="App.jsx - sessao lida do localStorage (authToken, userEmail, userRole, salaoId, userId) · roteamento por cargo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="280" height="60" as="geometry"/></mxCell><mxCell id="c177" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c173" target="c174"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c178" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c174" target="c175"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c179" value="Roteamento por cargo (App.jsx)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="360" height="20" as="geometry"/></mxCell><mxCell id="c180" value="VENDEDOR -&gt; VendedorApp (rotas /admin/*)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="375" y="95" width="330" height="40" as="geometry"/></mxCell><mxCell id="c181" value="PROPRIETARIO -&gt; Sidebar + rotas completas: /agenda /dashboard /precificacao /homecar /paralelos /clientes /configuracoes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="375" y="145" width="330" height="60" as="geometry"/></mxCell><mxCell id="c182" value="FUNCIONARIO -&gt; Sidebar somente /agenda e /clientes · rotas /dashboard /precificacao /homecar /paralelos /configuracoes -&gt; Navigate to /agenda" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="375" y="215" width="330" height="60" as="geometry"/></mxCell><mxCell id="c183" value="Protecao visual apenas - decisao final no backend" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="375" y="285" width="330" height="30" as="geometry"/></mxCell><mxCell id="c184" value="Protecao especifica do Dashboard (useDashboardProtection.js + DashboardLockOverlay.jsx)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="390" height="20" as="geometry"/></mxCell><mxCell id="c185" value="1. Proprietario acessa /dashboard" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="775" y="95" width="360" height="30" as="geometry"/></mxCell><mxCell id="c186" value="2. PIN solicitado · isLocked inicia true (so em memoria - nunca em localStorage/sessionStorage)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="775" y="135" width="360" height="50" as="geometry"/></mxCell><mxCell id="c187" value="3. POST /auth/verify-dashboard-password (exige middleware/auth.js)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="775" y="195" width="360" height="40" as="geometry"/></mxCell><mxCell id="c188" value="4. Backend compara PIN com dashboard_pin de configuracoes (WHERE salao_id = JWT) · retorna apenas { authorized } - PIN NUNCA exposto · frontend nunca salva PIN em storage" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="775" y="245" width="360" height="70" as="geometry"/></mxCell><mxCell id="c189" value="5. visibilitychange + window.blur bloqueiam a tela ao perder foco" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="775" y="325" width="360" height="40" as="geometry"/></mxCell><mxCell id="c190" value="DIVERGENCIA: reset de PIN no codigo atual e feito pelo FRONTEND - gerarPin() com Math.random e PUT /cadastros/configuracoes/:id apos validar senha via POST /auth/verify-login-password (DashboardLockOverlay.jsx e Configuracoes.jsx). O backend NAO gera o novo PIN. Classificacao: Implementado parcialmente + risco (senha de login validada no backend OK, mas novo PIN definido no frontend)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="775" y="375" width="360" height="120" as="geometry"/></mxCell><mxCell id="c191" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c185" target="c186"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c192" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c186" target="c187"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c193" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c187" target="c188"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c194" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c188" target="c189"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c195" value="API, resiliencia e motor financeiro (src/services)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="340" height="20" as="geometry"/></mxCell><mxCell id="c196" value="api.js - fetchWithAuth injeta Bearer em todas as requisicoes · 401 (fora de /auth/login) limpa storage e redireciona (anti-zumbi)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="365" width="340" height="60" as="geometry"/></mxCell><mxCell id="c197" value="getComRetry: 3 tentativas, backoff exponencial + jitter para 429/502/503/504 - mitiga cold start do Render free" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="435" width="340" height="50" as="geometry"/></mxCell><mxCell id="c198" value="criarPool(n): concorrencia limitada (Dashboard usa criarPool(3)) - evita estourar rate limit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="495" width="340" height="50" as="geometry"/></mxCell><mxCell id="c199" value="FinancialEngine.js - replica frontend do motor backend: aritmetica em centavos inteiros (toCents/toReais) · calcularPrecoPMG · calcularAtendimento · calcularHomeCare · calcularParalelo · calcularResumoMensal · calcularValorBase (engenharia reversa)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="40" y="555" width="340" height="90" as="geometry"/></mxCell><mxCell id="c200" value="BannerOffline.jsx - navigator.onLine + eventos offline/online" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="340" height="40" as="geometry"/></mxCell><mxCell id="c201" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c196" target="c197"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c202" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c197" target="c198"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c203" value="Modulos do proprietario (src/pages)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="400" y="340" width="320" height="20" as="geometry"/></mxCell><mxCell id="c204" value="Agenda.jsx - CRUD de atendimentos + previa financeira em tempo real · GET /relatorios/custo-composto-salao" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="415" y="365" width="290" height="50" as="geometry"/></mxCell><mxCell id="c205" value="Dashboard.jsx - fechamento mensal, graficos, ranking, resultado · getComRetry para /fechamento/:mes (criarPool 3 meses), /relatorios/ranking-procedimentos, /relatorios/rendimento-professional, /cadastros/custos-fixos, /relatorios/homecare-anual" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="415" y="425" width="290" height="80" as="geometry"/></mxCell><mxCell id="c206" value="Precificacao.jsx - motor de precos, engenharia reversa, simulador · /relatorios/custo-composto-salao" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="415" y="515" width="290" height="50" as="geometry"/></mxCell><mxCell id="c207" value="HomeCar.jsx - vendas de produtos homecare (CRUD /cadastros/homecare)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="415" y="575" width="290" height="40" as="geometry"/></mxCell><mxCell id="c208" value="Paralelos.jsx - procedimentos fora da agenda (ex.: noivas e formaturas) · /cadastros/procedimentos-paralelos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="415" y="625" width="290" height="50" as="geometry"/></mxCell><mxCell id="c209" value="Clientes.jsx - cadastro + historico · /relatorios/clientes-resumo (total_gasto, ultima_visita)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="415" y="685" width="290" height="50" as="geometry"/></mxCell><mxCell id="c210" value="Configuracoes.jsx - taxa maquininha, custos fixos, equipe/salarios, protecao do dashboard (aba equipe) · PUT /cadastros/configuracoes/:id" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="415" y="745" width="290" height="60" as="geometry"/></mxCell><mxCell id="c211" value="Modulos do vendedor (src/vendedor)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="530" width="390" height="20" as="geometry"/></mxCell><mxCell id="c212" value="MeusSaloes.jsx - lista saloes do vendedor (GET /salao) · deleta via DELETE /salao/:id com ConfirmModal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="775" y="555" width="360" height="50" as="geometry"/></mxCell><mxCell id="c213" value="NovoSalao.jsx - wizard de 4 etapas; cria salao + proprietaria atomicamente (POST /salao/criar-proprietaria) · RISCO: gerarSenhaSegura() usa Math.random no FRONTEND (10 chars) e senha trafega no body; classificacao: Implementado parcialmente + risco (recomendado: geracao server-side com crypto)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="775" y="615" width="360" height="90" as="geometry"/></mxCell><mxCell id="c214" value="GerenciarSalao.jsx - exibe logins gerados (GET /admin/logins-gerados?salao_id=...) · senha_temporaria em texto + copia para WhatsApp - RISCO de exposicao por canal externo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="775" y="715" width="360" height="60" as="geometry"/></mxCell><mxCell id="c215" value="GerenciarAdmins.jsx - CRUD de administradores VENDEDOR (/admin/criar-admin, /admin/:user_id)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="775" y="785" width="360" height="40" as="geometry"/></mxCell><mxCell id="c216" value="Assinaturas.jsx - modulo DESATIVADO temporariamente (moduloDesativado=true; codigo Supabase mantido comentado) - legado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="775" y="835" width="360" height="50" as="geometry"/></mxCell><mxCell id="c217" value="vercel.json - politica de cache e SPA" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="500" height="20" as="geometry"/></mxCell><mxCell id="c218" value="rewrites: /(.*) -&gt; /index.html · headers: / e /index.html -&gt; Cache-Control: no-cache, no-store, must-revalidate + Pragma + Expires 0 · /assets/* -&gt; public, max-age=31536000, immutable (1 ano)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="55" y="925" width="480" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="04 - Backend e API" id="p4"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c219" value="Arquitetura detalhada do backend e API - backend-node/src (Node/Express no Render)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1A1A2E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1150" height="30" as="geometry"/></mxCell><mxCell id="c220" value="Bootstrap e pipeline (ordem real do app.js)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="350" height="20" as="geometry"/></mxCell><mxCell id="c221" value="server.js: require(./instrument.js) ANTES de app.js -&gt; require(./app) -&gt; app.listen(PORT 3333)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="350" height="50" as="geometry"/></mxCell><mxCell id="c222" value="instrument.js: Sentry.init({ dsn: SENTRY_DSN, integrations: [expressIntegration()] }) - inicializacao antes do app" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#B0E3E6;strokeColor=#0E8088;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="350" height="50" as="geometry"/></mxCell><mxCell id="c223" value="1. Security headers manuais (SEM Helmet): X-Content-Type-Options: nosniff · X-Frame-Options: DENY (anti-clickjacking) · X-XSS-Protection: 1; mode=block · Referrer-Policy: no-referrer · Cache-Control: no-store" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="350" height="80" as="geometry"/></mxCell><mxCell id="c224" value="2. CORS antes do rate limiter (429 tambem recebe headers CORS) · allowedOrigins = env ALLOWED_ORIGINS (default localhost:5173) + regex .vercel.app · credentials: true" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="305" width="350" height="60" as="geometry"/></mxCell><mxCell id="c225" value="3. express.json() - parse do body" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="350" height="30" as="geometry"/></mxCell><mxCell id="c226" value="4. generalLimiter: 1000 req/15min por IP (RATE_LIMIT_MAX) · standardHeaders · skip OPTIONS (preflight nao consome cota)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="350" height="60" as="geometry"/></mxCell><mxCell id="c227" value="5. loginLimiter em /auth/login: 100 tentativas/15min por IP (LOGIN_RATE_LIMIT_MAX)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="485" width="350" height="50" as="geometry"/></mxCell><mxCell id="c228" value="6. Sentry error handler: setupExpressErrorHandler(app) se SENTRY_DSN - ANTES do handler generico" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#B0E3E6;strokeColor=#0E8088;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="350" height="50" as="geometry"/></mxCell><mxCell id="c229" value="7. Generic error handler: console.error(err) · status 500 -&gt; mensagem Internal server error SEM stack trace · err.status propagado para 4xx" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="605" width="350" height="60" as="geometry"/></mxCell><mxCell id="c230" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c221" target="c222"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c231" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c222" target="c223"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c232" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c223" target="c224"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c233" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c224" target="c225"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c234" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c225" target="c226"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c235" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c226" target="c227"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c236" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c227" target="c228"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c237" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;" edge="1" parent="1" source="c228" target="c229"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c238" value="Banco (config/db.js) e protecoes estruturais" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="350" height="20" as="geometry"/></mxCell><mxCell id="c239" value="mysql2/promise · createPool: connectionLimit 20 · waitForConnections · queueLimit 0 · connectTimeout 10000" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="435" y="95" width="320" height="60" as="geometry"/></mxCell><mxCell id="c240" value="TLS obrigatorio: ssl { minVersion: TLSv1.2, rejectUnauthorized: true }" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="435" y="165" width="320" height="40" as="geometry"/></mxCell><mxCell id="c241" value="Queries 100% parametrizadas (placeholders ?) - protecao estrutural contra SQL Injection · sanitizacao de chaves no crud.controller: /^[a-zA-Z0-9_]+$/" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="435" y="215" width="320" height="60" as="geometry"/></mxCell><mxCell id="c242" value="Lockout brute-force in-memory (auth.controller.js): loginAttempts Map - MAX_ATTEMPTS 5, LOCKOUT_MS 15min, independente do express-rate-limit (reinicio do servico limpa o Map - Recomendado: store compartilhado tipo Redis)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="435" y="285" width="320" height="80" as="geometry"/></mxCell><mxCell id="c243" value="RISCO/Nao confirmado: limite de tamanho do body (express.json limit), statement timeout e protecao contra consultas pesadas nao configurados no pool" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="435" y="375" width="320" height="60" as="geometry"/></mxCell><mxCell id="c244" value="Rotas e middlewares (classificacao real)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="390" height="20" as="geometry"/></mxCell><mxCell id="c245" value="Rota" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontSize=10;fontStyle=1;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="800" y="95" width="200" height="26" as="geometry"/></mxCell><mxCell id="c246" value="Middleware aplicado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontSize=10;fontStyle=1;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1000" y="95" width="190" height="26" as="geometry"/></mxCell><mxCell id="c247" value="POST /auth/login" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="121" width="200" height="26" as="geometry"/></mxCell><mxCell id="c248" value="publica (limiter + lockout)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="121" width="190" height="26" as="geometry"/></mxCell><mxCell id="c249" value="POST /auth/verify-dashboard-password" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="147" width="200" height="26" as="geometry"/></mxCell><mxCell id="c250" value="auth.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="147" width="190" heigh