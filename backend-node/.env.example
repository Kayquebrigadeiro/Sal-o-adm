# ============================================
# Credenciais do Agente Noturno (exemplo)
# Copie este arquivo para .env e preencha
# ============================================

# Groq API
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Staging Database (TiDB)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=...
DB_PASSWORD=...
DB_NAME=SalaosecretoStaging

# JWT Secret (staging)
JWT_SECRET=...

# Staging server
STAGING_PORT=3334

# Sentry (opcional) — descomente e preencha para habilitar monitoramento de erros
# SENTRY_DSN=

# Test credentials
TEST_VENDEDOR_EMAIL=...
TEST_VENDEDOR_SENHA=...