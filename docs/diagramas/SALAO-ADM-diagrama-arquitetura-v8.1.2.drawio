401 -&gt; limpa localStorage + window.location.replace(chr(47))
getComRetry: 3 tentativas exp. 429/502/503/504
criarPool(3): concorrencia limitada
BannerOffline: navigator.onLine + offline/online
vercel.json: / no-cache, no-store; /assets/* 1 ano immutable" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="55" y="385" width="370" height="140" as="geometry"/></mxCell><mxCell id="c14" value="Fluxo de protecao na borda (app.js - ordem real)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="460" y="360" width="500" height="20" as="geometry"/></mxCell><mxCell id="c15" value="HTTPS -&gt; security headers (sem Helmet) -&gt; CORS (origens explicitas + *.vercel.app, credentials:true) -&gt; express.json -&gt; rate limit 1000/15min por IP (OPTIONS skip) -&gt; login limiter 100/15min -&gt; JWT (middleware/auth.js) -&gt; apenasVendedor (quando aplicavel)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="470" y="385" width="480" height="130" as="geometry"/></mxCell><mxCell id="c16" value="Backend - Render (Node/Express, porta 3333)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="400" height="20" as="geometry"/></mxCell><mxCell id="c17" value="server.js -&gt; instrument.js (Sentry.init expressIntegration) -&gt; app.js
